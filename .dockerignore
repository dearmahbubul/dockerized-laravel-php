# =============================================================================
# Docker build context ignore list
# The build fetches a fresh skeleton at build time; the repo root (a clean
# clone or the bind-mount after first boot) carries generated Laravel code
# that must NOT be sent to the daemon or baked into the image.
# =============================================================================

# VCS / IDE
.git
.gitignore
.gitattributes
.idea
.vscode
*.swp
*.swo

# Environment / secrets (docker/.env.docker is the safe template)
.env
.env.*
!.env.example
!docker/.env.docker

# Generated Laravel app code (repo root is a bind mount at runtime)
artisan
app
bootstrap
config
database
public
resources
routes
storage/*
!storage/.gitkeep
tests
vendor
node_modules
composer.json
composer.lock
package.json
package-lock.json

# Compose / tooling
docker-compose.yml
docker-compose.yaml
docker-compose.*.yml
docker-compose.*.yaml
*.md
AGENTS.md
composer.phar

# Runtime artifacts
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
!storage/logs/.gitkeep
!storage/framework/cache/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/views/.gitkeep
.phpunit.cache
.phpunit.result.cache
public/hot
public/build

# Windows reserved-name junk
NUL
NUL.txt
nul
