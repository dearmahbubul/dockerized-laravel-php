# =============================================================================
# PRODUCTION environment — copy to `.env.prod` (git-ignored) and fill in.
#   cp docker/.env.prod.example .env.prod
# This file is mounted into every service via env_file. NEVER commit `.env.prod`.
# =============================================================================
APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public URL, must match your real domain / TLS cert
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs go to stdout/stderr (captured by Docker), not disk
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ------------------------
# PRIMARY DATABASE
# ------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
# CHANGE ME
DB_PASSWORD=CHANGE_ME

# To use PostgreSQL as the primary app DB: DB_CONNECTION=pgsql, DB_HOST=postgres,
# DB_PORT=5432, DB_DATABASE=laravel, DB_USERNAME=laravel, DB_PASSWORD=...

# ------------------------
# VECTOR DATABASE (always PostgreSQL + pgvector)
# ------------------------
VECTOR_DB_HOST=postgres
VECTOR_DB_PORT=5432
VECTOR_DB_DATABASE=vector
VECTOR_DB_USERNAME=laravel
# CHANGE ME
VECTOR_DB_PASSWORD=CHANGE_ME

# ------------------------
# SECRETS — CHANGE ME (generate: openssl rand -base64 32)
# ------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# ------------------------
# AI / EMBEDDINGS
# ------------------------
OPENAI_API_KEY=
AI_EMBEDDINGS_MODEL=text-embedding-3-small
AI_EMBEDDINGS_DIMENSIONS=1536

# ------------------------
# CACHE / SESSION / QUEUE (Redis, auth required)
# ------------------------
CACHE_STORE=redis
CACHE_PREFIX=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_PORT=6379

# Session/cache keys must not collide across deployments
CACHE_PREFIX=prod-

# ------------------------
# MAIL — real SMTP, NOT Mailpit
# ------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------
# BROADCAST / FILESYSTEM / HORIZON
# ------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Horizon dashboard auth (default uses gate — leave as is)
HORIZON_PREFIX=horizon

# ------------------------
# RESOURCE LIMITS (optional, compose reads these)
# ------------------------
APP_MEM_LIMIT=512m
APP_CPUS=1.0