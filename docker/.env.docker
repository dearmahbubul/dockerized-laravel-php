APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ------------------------
# PRIMARY DATABASE
# Pick one: mysql or pgsql  (both servers run; just flip DB_CONNECTION)
# ------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# To use PostgreSQL as the primary app DB, switch to:
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=laravel   (create it: docker compose exec postgres createdb -U laravel laravel)
# DB_USERNAME=laravel
# DB_PASSWORD=secret

# ------------------------
# VECTOR DATABASE (always PostgreSQL + pgvector — for embeddings)
# ------------------------
VECTOR_DB_HOST=postgres
VECTOR_DB_PORT=5432
VECTOR_DB_DATABASE=vector
VECTOR_DB_USERNAME=laravel
VECTOR_DB_PASSWORD=secret

# ------------------------
# AI / EMBEDDINGS (OpenAI — set your key to generate real embeddings)
# ------------------------
OPENAI_API_KEY=
AI_EMBEDDINGS_MODEL=text-embedding-3-small
AI_EMBEDDINGS_DIMENSIONS=1536

# ------------------------
# CACHE / SESSION / QUEUE (Redis)
# ------------------------
CACHE_STORE=redis
CACHE_PREFIX=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis

# ------------------------
# REDIS
# ------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------
# MAIL (Mailpit — SMTP on :1025, web UI on :8025)
# ------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------
# BROADCAST / FILESYSTEM
# ------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
