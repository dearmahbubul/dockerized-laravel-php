# =============================================================================
# Repo is Docker-only. Laravel app code is generated at first boot into the
# bind-mounted root, so ignore everything that would otherwise get committed.
# =============================================================================

# Laravel app (generated at first boot)
/artisan
/app
/bootstrap
/config
/database
/public
/resources
/routes
/storage
/tests
/vendor
/node_modules
/composer.json
/composer.lock
/package.json
/package-lock.json
/vite.config.js
/phpunit.xml

# Skeleton dotfiles brought in by first-boot materialisation
# (README.md is intentionally tracked — it's our doc, not the skeleton's)
/.editorconfig
/.env.example
/.gitattributes
/.npmrc
/AGENTS.md
/CLAUDE.md

# Environment
.env
.env.*
!/docker/.env.docker
!/docker/.env.prod.example

# Production backups
/backups/

# Windows reserved-name junk (stray `curl -o NUL` in the bind mount)
/NUL
/NUL.txt
/nul

# TLS certs (generated by docker/nginx/tools/generate-ssl.sh — never commit keys)
/docker/nginx/certs/

# Logs / OS / IDE
*.log
.DS_Store
Thumbs.db
.idea
.vscode