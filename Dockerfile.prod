# =============================================================================
# PRODUCTION image — built by CI from YOUR Laravel application source.
# Build context = the application repo (all app code, node_modules/vendor
# excluded via .dockerignore in that repo). This Docker-only repo is the dev
# companion and contains no app source — it cannot be built directly.
#
#   docker build -f Dockerfile.prod -t myapp:prod .
#
# Differences vs. the dev image (Dockerfile):
#   - Immutable: app code is baked in, nothing is materialised at boot.
#   - Runs as non-root (www-data), no xdebug/phpMyAdmin tooling, --no-dev deps.
#   - Frontend assets pre-built, no node service needed at runtime.
#   - No self-gen secrets: APP_KEY etc. come from the environment (CI/secrets).
# =============================================================================

# ---- Stage 1: PHP dependencies (no dev packages, prod autoloader) ----------
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --no-scripts \
    --prefer-dist --optimize-autoloader

# ---- Stage 2: frontend assets (built once, copied into runtime) -------------
FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

# ---- Stage 3: runtime -------------------------------------------------------
FROM php:8.4-fpm AS runtime

LABEL org.opencontainers.image.source="" \
      org.opencontainers.image.title="Laravel app" \
      org.opencontainers.image.description="Production runtime image"

RUN apt-get update && apt-get install -y --no-install-recommends \
        libzip-dev libpng-dev libfreetype6-dev libjpeg62-turbo-dev libpq-dev \
        libicu-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        pdo pdo_mysql pdo_pgsql zip gd pcntl posix sockets intl \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/*

# FPM pool tuning handled in prod.conf / env. Min/max children come from env.
# (Uncomment to wire env-driven pool sizing:)
# RUN printf '[www]\npm = dynamic\npm.max_children = ${FPM_MAX_CHILDREN}\npm.start_servers = ${FPM_START_SERVERS}\npm.min_spare_servers = ${FPM_MIN_SPARE}\npm.max_spare_servers = ${FPM_MAX_SPARE}\n' \x26gt; /usr/local/etc/php-fpm.d/zz-pool.conf

# Application code + built deps/assets
COPY --from=vendor  /app/vendor        /var/www/vendor
COPY --from=assets  /app/public/build  /var/www/public/build
COPY . /var/www

WORKDIR /var/www

# Persistence + runtime-writable dirs are mounted by compose; keep image clean.
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache \
    && chmod -R u+rwX,g+rwX /var/www/storage /var/www/bootstrap/cache

USER www-data

# Config as immutable as possible: bake caches at image build time in CI
# (copy stage above happens before RUN with config present):
# RUN php artisan optimize
# RUN php artisan event:cache && php artisan view:cache

EXPOSE 9000

# Healthcheck (fpm reachable on 127.0.0.1:9000)
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD php -r "if (!@stream_socket_client('tcp://127.0.0.1:9000', \$e, \$s, 2)) exit(1);"

STOPSIGNAL SIGQUIT
CMD ["php-fpm", "-F"]